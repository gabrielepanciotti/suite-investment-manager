# suite-managed (deploy) — regenerated by conform, do not edit by hand.
# Build context is `..` (the node root): without these excludes a .venv/
# node_modules/dist accidentally present on the host gets sent to the Docker
# daemon in full, inflating the context to 100s of MB and getting the build
# killed by the watchdog long before the first COPY runs.
.git
**/.git
**/.DS_Store
.venv
**/.venv
backend/.venv
**/__pycache__
**/*.pyc
**/node_modules
frontend/node_modules
**/dist
frontend/dist
frontend/*.tsbuildinfo
vault
old
brain
docs
.claude
*.md
.env
.env.*
