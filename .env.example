# >>> suite-managed (env) >>>
# Copy to .env — the generated compose fails fast when DB_PASSWORD is
# unset (no silent default is baked into the committed compose files).
# NOTE: compose reads interpolation vars from the project directory
# (deploy/), not the node root — launch with the root env explicitly:
#   docker compose --env-file .env -f deploy/docker-compose.yml up -d
# This placeholder is intentionally not a credential. Replace it in .env.
DB_PASSWORD=example-not-a-secret
# Host port for the node DB (published on 127.0.0.1 only); the value
# below is the registry default — override only on port conflicts.
DB_HOST_PORT=11338
# <<< suite-managed (env) <<<

# App DSN for the backend (asyncpg driver, matches DB_PASSWORD/DB_HOST_PORT above).
DATABASE_URL=postgresql+asyncpg://investment_manager:example-not-a-secret@127.0.0.1:11338/investment_manager
