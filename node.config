{
  "schemaVersion": "2.0",
  "name": "InvestmentManager",
  "slug": "investmentManager",
  "type": "fastapi-app",
  "famiglia": "tracker",
  "kind": "istanza",
  "hostBase": "investment-manager.life.local",
  "inherits": "../Life/node.config",
  "taxonomy": {
    "id": "investmentManager",
    "cluster": [
      "Finance"
    ],
    "displayName": "InvestmentManager",
    "commercial": false
  },
  "tooling": {},
  "capabilities": [],
  "agents": {
    "archetypes": []
  },
  "mcp": {
    "toolsets": []
  },
  "children": [],
  "deploy": {
    "backendPkg": "investment_manager_backend",
    "migrations": true,
    "database": {
      "name": "investmentmanager",
      "user": "investmentmanager",
      "host": "investmentmanager-db",
      "driver": "postgresql+asyncpg",
      "image": "postgres:16"
    }
  }
}
